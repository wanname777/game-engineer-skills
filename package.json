{
  "name": "game-engineer-skills",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "python3 scripts/prepare_static_demos.py && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:skills": "python3 scripts/validate_skills.py",
    "check:budget": "python3 scripts/check_context_budget.py --all",
    "test:context": "python3 .agents/skills/recover-project-context/scripts/test_context_pack.py",
    "check": "npm run check:skills && npm run check:budget && npm run test:context && npm run build && npm test && npm run test:e2e",
    "render:motion": "node scripts/render-motion.mjs",
    "context:pack": "python3 scripts/context_pack.py",
    "install:skills": "python3 scripts/install_skills.py"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^5.1.0"
  }
}
